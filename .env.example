POSTGRES_DB=crowl
POSTGRES_USER=crowl
POSTGRES_PASSWORD=crowl_dev_only
DATABASE_URL=postgresql+psycopg://crowl:crowl_dev_only@postgres:5432/crowl
API_URL=http://api:8000
VITE_API_BASE_URL=/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
MAP_TILE_ORIGIN=https://tiles.openfreemap.org
CROWL_DATA_DIR=/app/data
CROWL_BATCH_CRON=0 2 * * *
CROWL_BATCH_DEADLINE_HOURS=20
CROWL_STRICT_SCHENGEN_PATH=true
CROWL_AUTO_CREATE_SCHEMA=false
CROWL_AUTO_SEED=true
CROWL_SEED_FIXTURES=false
CROWL_FRESHNESS_HOURS=36
CROWL_DURATION_HISTORY_DAYS=180
CROWL_SCHEMA_REVISION=0006_flixbus_fare_policy
CROWL_LOG_LEVEL=INFO

# FlixBus runs the verified Paris-Amsterdam and Paris-Brussels searches.
# Coverage ends at the last tested return date.
CROWL_FLIXBUS_PUBLIC_SEARCH_URL_TEMPLATE=https://shop.global.flixbus.com/search?departureCity={origin}&arrivalCity={destination}&rideDate={date_dot}&adult=1&currency=EUR
CROWL_FLIXBUS_TERMINAL_ALIASES_JSON={"par-bercy-seine-bus":"40de8964-8646-11e6-9066-549f350fcb0c","ams-sloterdijk-bus":"40dde3b8-8646-11e6-9066-549f350fcb0c","bru-gare-du-midi-bus":"40de6287-8646-11e6-9066-549f350fcb0c"}
CROWL_FLIXBUS_STOP_ALIASES_JSON={"Paris (Bercy Seine)":"par-bercy-seine-bus","Amsterdam Sloterdijk":"ams-sloterdijk-bus","Brussels South (Gare du Midi)":"bru-gare-du-midi-bus"}
CROWL_FLIXBUS_COVERAGE_JSON={"supported_terminal_pairs":[["par-bercy-seine-bus","ams-sloterdijk-bus"],["par-bercy-seine-bus","bru-gare-du-midi-bus"]],"sellable_through":"2027-05-24"}

# Disabled connectors stay network-free in the scheduled batch.
# The documented public Ryanair page was validated for a bounded canary.
