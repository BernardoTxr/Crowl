POSTGRES_DB=crowl
POSTGRES_USER=crowl
POSTGRES_PASSWORD=crowl_dev_only
DATABASE_URL=postgresql+psycopg://crowl:crowl_dev_only@postgres:5432/crowl
API_URL=http://api:8000
VITE_API_BASE_URL=/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
MAP_TILE_ORIGIN=https://tiles.openfreemap.org
CROWL_DATA_DIR=/app/data
CROWL_BATCH_CRON=0 2 * * *
CROWL_BATCH_DEADLINE_HOURS=20
CROWL_STRICT_SCHENGEN_PATH=true
CROWL_AUTO_CREATE_SCHEMA=false
CROWL_AUTO_SEED=true
CROWL_SEED_FIXTURES=false
CROWL_FRESHNESS_HOURS=36
CROWL_DURATION_HISTORY_DAYS=180
CROWL_SCHEMA_REVISION=0006_flixbus_fare_policy
CROWL_LOG_LEVEL=INFO

# FlixBus is enabled only for this verified public Paris-Amsterdam route. These
# are public identifiers, not credentials. The coverage date is the last return
# date verified by the 2026-11-21 six-month-horizon canary.
CROWL_FLIXBUS_PUBLIC_SEARCH_URL_TEMPLATE=https://shop.global.flixbus.com/search?departureCity={origin}&arrivalCity={destination}&rideDate={date_dot}&adult=1&currency=EUR
CROWL_FLIXBUS_TERMINAL_ALIASES_JSON={"par-bercy-seine-bus":"40de8964-8646-11e6-9066-549f350fcb0c","ams-sloterdijk-bus":"40dde3b8-8646-11e6-9066-549f350fcb0c"}
CROWL_FLIXBUS_STOP_ALIASES_JSON={"Paris (Bercy Seine)":"par-bercy-seine-bus","Amsterdam Sloterdijk":"ams-sloterdijk-bus"}
CROWL_FLIXBUS_COVERAGE_JSON={"supported_terminal_pairs":[["par-bercy-seine-bus","ams-sloterdijk-bus"]],"sellable_through":"2027-05-24"}

# The other public-page extractors remain disabled and network-free. These are
# naming examples only; do not configure or enable one until its live markup,
# aliases, coverage, and limits have been reviewed. Never put login credentials
# or cookies here.
# Flight: CROWL_RYANAIR_PUBLIC_PAGE_URL=
# Flight: CROWL_RYANAIR_PUBLIC_ROUTE_PAIRS=par-bva:lis-humberto-delgado
# Train: CROWL_EUROSTAR_HTML_URL_TEMPLATE=
# Train: CROWL_EUROSTAR_TERMINAL_ALIASES_JSON={"par-gare-du-nord":"PAR_PROVIDER","ams-centraal":"AMS_PROVIDER"}
# Train: CROWL_EUROSTAR_COVERAGE_JSON={"source":"eurostar","routes":[["par-gare-du-nord","ams-centraal"]],"sellable_through":"2027-06-30"}
# Train: CROWL_EUROSTAR_TIMEOUT_SECONDS=30
