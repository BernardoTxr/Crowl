{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowl.local/schemas/sources.schema.json",
  "title": "Crowl source feasibility register",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id", "name", "modes", "strategy", "state", "enabled", "kill_switch",
        "config_version", "access_basis", "access_note", "rate_limit",
        "markets", "sale_horizon_days", "attribution_required",
        "booking_link_required", "booking_hosts", "route_discovery"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["flight", "train", "bus"] }
        },
        "strategy": { "enum": ["http_structured", "http_html", "playwright", "disabled"] },
        "state": { "enum": ["enabled", "disabled", "disabled_needs_authorization", "disabled_needs_credentials"] },
        "enabled": { "type": "boolean" },
        "kill_switch": { "type": "boolean" },
        "config_version": { "type": "string", "minLength": 1 },
        "access_basis": { "type": "string", "minLength": 1 },
        "access_note": { "type": "string", "minLength": 1 },
        "rate_limit": {
          "type": "object",
          "required": ["requests_per_minute", "max_concurrency", "status"],
          "additionalProperties": false,
          "properties": {
            "requests_per_minute": { "type": ["integer", "null"], "minimum": 1 },
            "max_concurrency": { "type": "integer", "minimum": 0 },
            "status": { "enum": ["unknown_until_authorized", "verified"] }
          }
        },
        "markets": {
          "type": "object",
          "required": ["origins", "destinations", "status"],
          "additionalProperties": false,
          "properties": {
            "origins": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "destinations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "status": { "enum": ["unknown_until_authorized", "verified"] }
          }
        },
        "sale_horizon_days": { "type": ["integer", "null"], "minimum": 1 },
        "attribution_required": { "type": ["boolean", "null"] },
        "booking_link_required": { "const": true },
        "booking_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          }
        },
        "route_discovery": {
          "type": "object",
          "required": ["method", "status", "provenance"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "status": { "enum": ["blocked_access", "configured", "verified"] },
            "provenance": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
