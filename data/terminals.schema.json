{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowl.local/schemas/terminals.schema.json",
  "title": "Crowl terminal catalog",
  "type": "object",
  "required": ["schemaVersion", "strictSchengenPath", "originTerminalIds", "terminals", "cityTerminalLinks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "strictSchengenPath": { "const": true },
    "originTerminalIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "terminals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/terminal" }
    },
    "cityTerminalLinks": {
      "type": "array",
      "items": { "$ref": "#/$defs/cityTerminalLink" }
    },
    "terminalTransfers": {
      "type": "array",
      "items": { "$ref": "#/$defs/terminalTransfer" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "coordinates": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "terminal": {
      "type": "object",
      "required": ["id", "name", "kind", "timezone", "countryCode", "coordinates", "codes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["airport", "rail", "bus"] },
        "timezone": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "codes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "active": { "type": "boolean" },
        "schengenEligible": { "type": "boolean" }
      }
    },
    "cityTerminalLink": {
      "type": "object",
      "required": ["cityId", "terminalId", "relationship"],
      "additionalProperties": false,
      "properties": {
        "cityId": { "$ref": "#/$defs/id" },
        "terminalId": { "$ref": "#/$defs/id" },
        "relationship": {
          "enum": ["primary", "primary_airport", "primary_station", "primary_bus", "nearby_airport", "nearby_station", "nearby_bus"]
        }
      }
    },
    "terminalTransfer": {
      "type": "object",
      "required": ["fromTerminalId", "toTerminalId", "minimumMinutes", "costEurCents", "costIsComplete", "evidenceUrl"],
      "additionalProperties": false,
      "properties": {
        "fromTerminalId": { "$ref": "#/$defs/id" },
        "toTerminalId": { "$ref": "#/$defs/id" },
        "minimumMinutes": { "type": "integer", "minimum": 0 },
        "costEurCents": { "type": ["integer", "null"], "minimum": 0 },
        "costIsComplete": { "type": "boolean" },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" }
      }
    }
  }
}
