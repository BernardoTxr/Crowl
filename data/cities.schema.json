{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowl.local/schemas/cities.schema.json",
  "title": "Crowl city catalog",
  "type": "object",
  "required": ["schemaVersion", "catalogVariant", "origin", "categoryDefinitions", "attributeDefinitions", "cities"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVariant": { "const": "final" },
    "origin": { "$ref": "#/$defs/origin" },
    "categoryDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/categoryDefinition" }
    },
    "attributeDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attributeDefinition" }
    },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/city" }
    }
  },
  "$defs": {
    "coordinates": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "origin": {
      "type": "object",
      "required": ["id", "name", "timezone", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "coordinates": { "$ref": "#/$defs/coordinates" }
      }
    },
    "categoryDefinition": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "attributeDefinition": {
      "type": "object",
      "required": ["id", "label", "min", "max", "lowLabel", "highLabel"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "min": { "const": 1 },
        "max": { "const": 5 },
        "lowLabel": { "type": "string", "minLength": 1 },
        "highLabel": { "type": "string", "minLength": 1 }
      }
    },
    "country": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "type": "object",
      "required": ["visited", "wishlist"],
      "additionalProperties": false,
      "properties": {
        "visited": { "type": "boolean" },
        "wishlist": { "type": "boolean" }
      }
    },
    "photo": {
      "type": "object",
      "required": ["asset", "originalAsset", "optimizedAssets", "alt", "creator", "sourceUrl", "license", "attribution", "curationStatus", "objectPosition"],
      "additionalProperties": false,
      "properties": {
        "asset": { "type": "string", "minLength": 1 },
        "originalAsset": { "type": ["string", "null"], "minLength": 1 },
        "optimizedAssets": {
          "type": ["object", "null"],
          "required": ["avif", "webp"],
          "additionalProperties": false,
          "properties": {
            "avif": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "\\.avif$" }
            },
            "webp": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "\\.webp$" }
            }
          }
        },
        "alt": { "type": "string", "minLength": 1 },
        "creator": { "type": ["string", "null"] },
        "sourceUrl": { "type": ["string", "null"], "format": "uri-reference" },
        "license": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] },
        "curationStatus": { "enum": ["pending", "curated"] },
        "objectPosition": { "type": "string", "minLength": 1 }
      }
    },
    "city": {
      "type": "object",
      "required": ["id", "slug", "name", "country", "timezone", "coordinates", "status", "categories", "summary", "attributes", "photo"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "country": { "$ref": "#/$defs/country" },
        "timezone": { "type": "string", "minLength": 1 },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "status": { "$ref": "#/$defs/status" },
        "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "photo": { "$ref": "#/$defs/photo" }
      }
    }
  }
}
